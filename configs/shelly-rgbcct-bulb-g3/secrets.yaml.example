# Copy to secrets.yaml (which is git-ignored) and fill in your values.
wifi_ssid: "your-wifi"
wifi_password: "your-password"
# password of the fallback access point (min. 8 characters), never reuse your Wi-Fi password
ap_password: "choose-a-password"
# generate with: openssl rand -base64 32
api_key: "base64-key-32-bytes"
